<h2 style='color:#1a1a1a;margin:0 0 16px 0;'>Ladesitzungsbericht {{periodLabel}}</h2>
{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hallo {{firstName}},</p>{{/if}}
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{companyName}} sendet dir den Bericht deiner Ladevorgänge im Zeitraum {{periodLabel}}, geladen über <strong>{{fleetName}}</strong>. Der Bericht ist als PDF angehängt.</p>
<table style='width:100%;border-collapse:collapse;margin:0 0 16px 0;'>
  <tr><td style='padding:6px 0;color:#6b7280;'>Zeitraum</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{periodLabel}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Ladevorgänge</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{sessionCount}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Erstellt am</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{issuedAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#1a1a1a;'><strong>Summe brutto</strong></td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'><strong>{{total}}</strong></td></tr>
</table>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Dieser Bericht ist keine Rechnung. Die Abrechnung erfolgt gesondert.</p>
