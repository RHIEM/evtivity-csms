<h2 style='color:#1a1a1a;margin:0 0 16px 0;'>充電會話報告 {{periodLabel}}</h2>
{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{firstName}}，您好：</p>{{/if}}
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{companyName}} 向您寄送 {{periodLabel}} 的充電會話報告，費用記入 <strong>{{fleetName}}</strong> 帳戶。報告以 PDF 附件形式提供。</p>
<table style='width:100%;border-collapse:collapse;margin:0 0 16px 0;'>
  <tr><td style='padding:6px 0;color:#6b7280;'>期間</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{periodLabel}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>充電會話</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{sessionCount}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>建立日期</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{issuedAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#1a1a1a;'><strong>總額合計</strong></td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'><strong>{{total}}</strong></td></tr>
</table>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>本報告不是發票。費用另行結算。</p>
