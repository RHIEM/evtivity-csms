<h2 style='color:#1a1a1a;margin:0 0 16px 0;'>Charging session report {{periodLabel}}</h2>
{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hi {{firstName}},</p>{{/if}}
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{companyName}} sends you the report of your charging sessions in {{periodLabel}}, charged on account of <strong>{{fleetName}}</strong>. The report is attached as a PDF.</p>
<table style='width:100%;border-collapse:collapse;margin:0 0 16px 0;'>
  <tr><td style='padding:6px 0;color:#6b7280;'>Period</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{periodLabel}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Charging sessions</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{sessionCount}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Created</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{issuedAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#1a1a1a;'><strong>Total gross</strong></td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'><strong>{{total}}</strong></td></tr>
</table>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>This report is not an invoice. The sessions are invoiced separately.</p>
